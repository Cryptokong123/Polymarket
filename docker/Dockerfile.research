# Polymarket Trading Bot - Python Research Layer
# Handles market analysis and signal generation

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY python-research/requirements.txt ./python-research/

# Install Python dependencies
RUN pip install --no-cache-dir -r python-research/requirements.txt

# Copy application code
COPY python-research/ ./python-research/
COPY .env.example ./

# Create necessary directories
RUN mkdir -p /app/shared/signals /app/shared/executed /app/shared/results /app/data/chroma

# Set Python path
ENV PYTHONPATH=/app/python-research
ENV PYTHONUNBUFFERED=1

# Default command
CMD ["python", "python-research/signal_generator.py"]
