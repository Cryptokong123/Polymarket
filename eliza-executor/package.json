{
  "name": "polymarket-executor",
  "version": "1.0.0",
  "description": "Polymarket Trading Bot - Signal Executor Layer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/executor.js",
    "dev": "ts-node src/executor.ts",
    "watch": "ts-node-dev --respawn src/executor.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client": "^4.0.0",
    "chokidar": "^3.5.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "winston": "^3.11.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading-bot",
    "automated-trading"
  ],
  "author": "",
  "license": "MIT"
}
