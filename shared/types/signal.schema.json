{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradingSignal",
  "description": "Trading signal schema for communication between Python research and TypeScript executor",
  "type": "object",
  "required": [
    "signal_id",
    "timestamp",
    "market_id",
    "token_id",
    "market_question",
    "side",
    "token_type",
    "current_price",
    "predicted_probability",
    "expected_value",
    "confidence",
    "reasoning",
    "suggested_size",
    "max_price",
    "min_price",
    "expires_at"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "Unique signal identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Signal creation timestamp (ISO 8601)"
    },
    "market_id": {
      "type": "string",
      "description": "Polymarket condition ID"
    },
    "token_id": {
      "type": "string",
      "description": "Token ID for the trade"
    },
    "market_question": {
      "type": "string",
      "description": "Market question text"
    },
    "side": {
      "type": "string",
      "enum": ["BUY", "SELL"],
      "description": "Order side"
    },
    "token_type": {
      "type": "string",
      "enum": ["YES", "NO"],
      "description": "Token type"
    },
    "current_price": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Current token price"
    },
    "predicted_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "LLM predicted probability"
    },
    "expected_value": {
      "type": "number",
      "description": "Expected value of the trade"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in prediction"
    },
    "reasoning": {
      "type": "string",
      "description": "LLM reasoning for the signal"
    },
    "suggested_size": {
      "type": "number",
      "minimum": 0,
      "description": "Suggested position size in USDC"
    },
    "max_price": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Maximum price for BUY orders"
    },
    "min_price": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Minimum price for SELL orders"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Signal expiration timestamp (ISO 8601)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "executing", "executed", "failed", "expired", "cancelled"],
      "default": "pending",
      "description": "Signal status"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "liquidity": {
          "type": "number",
          "description": "Market liquidity"
        },
        "volume_24h": {
          "type": "number",
          "description": "24-hour trading volume"
        },
        "key_factors": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Key factors in analysis"
        },
        "risk_factors": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Risk factors"
        },
        "sentiment": {
          "type": "string",
          "enum": ["bullish", "bearish", "neutral"],
          "description": "Market sentiment"
        }
      }
    }
  }
}
