# ============================================
# POLYMARKET AUTONOMOUS TRADING BOT
# Environment Configuration
# ============================================

# ============================================
# WALLET CONFIGURATION
# ============================================
# Your Polygon wallet private key (for signing transactions)
# CRITICAL: Never commit this file with real values!
POLYGON_WALLET_PRIVATE_KEY=

# Your wallet address (funder address for proxy wallets)
WALLET_ADDRESS=

# ============================================
# POLYMARKET API
# ============================================
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# These are generated via the API - leave blank initially
# They will be auto-generated on first run
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ============================================
# LLM CONFIGURATION
# ============================================
# Choose ONE provider - FREE OPTIONS LISTED FIRST!

# Which provider to use: ollama, groq, google, openai, anthropic
LLM_PROVIDER=ollama

# ============================================
# OPTION 1: OLLAMA (100% FREE - Runs Locally)
# ============================================
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Then run: ollama pull llama3.1:8b  (or llama3.1:70b for better quality)
# Start server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ============================================
# OPTION 2: GROQ (FREE Cloud API - Very Fast!)
# ============================================
# Get free API key at: https://console.groq.com/keys
# Free tier: 30 requests/minute, 14,400 requests/day
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# OPTION 3: GOOGLE GEMINI (FREE Tier Available)
# ============================================
# Get free API key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute, 1,500 requests/day
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ============================================
# OPTION 4: PAID OPTIONS (OpenAI / Anthropic)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ============================================
# TRADING PARAMETERS
# ============================================
# Maximum position size in USDC per trade
MAX_POSITION_SIZE=100

# Minimum expected value to trigger trade (e.g., 0.05 = 5%)
# Higher = fewer but higher conviction trades
MIN_EXPECTED_VALUE=0.05

# Maximum number of concurrent positions
MAX_POSITIONS=10

# Minimum liquidity required in order book (USDC)
MIN_LIQUIDITY=1000

# Maximum slippage allowed (0.02 = 2%)
MAX_SLIPPAGE=0.02

# ============================================
# NEW MARKET EDGE (First-Mover Advantage)
# ============================================
# Prioritize new markets for first-mover edge
PRIORITIZE_NEW_MARKETS=true

# Markets younger than this are considered "new" (hours)
NEW_MARKET_HOURS=48

# EV bonus added to new markets (0.02 = +2%)
# Makes new markets more likely to trigger trades
NEW_MARKET_EV_BONUS=0.02

# ============================================
# CRYPTO/BITCOIN PRICE MARKETS (Short-Term)
# ============================================
# Enable technical analysis for crypto price markets
# Provides RSI, MACD, Moving Averages, etc. to the AI
CRYPTO_TA_ENABLED=true

# Faster scanning for short-term crypto markets (seconds)
# These markets are time-sensitive (15-min, 1-hour windows)
CRYPTO_FAST_SCAN_INTERVAL=30

# EV bonus for crypto price markets (0.03 = +3%)
# Crypto TA gives AI an edge on these markets
CRYPTO_EV_BONUS=0.03

# Minimum confidence required for crypto trades
# Higher = more selective (0.6 = 60%)
CRYPTO_MIN_CONFIDENCE=0.6

# ============================================
# RESEARCH PARAMETERS
# ============================================
# News sources to monitor (comma-separated)
NEWS_SOURCES=polymarket,twitter,newsapi

# How often to scan for opportunities (seconds)
# Default: 300 (5 minutes) - lower values may hit rate limits
SCAN_INTERVAL=300

# Chroma DB path for RAG
CHROMA_DB_PATH=./data/chroma

# Maximum markets to analyze per scan
MAX_MARKETS_PER_SCAN=50

# ============================================
# NEWS API CONFIGURATION (Optional)
# ============================================
# NewsAPI.org key for news research
NEWSAPI_KEY=

# Twitter/X API for social signals (Optional)
TWITTER_BEARER_TOKEN=

# Tavily API for web search (Optional)
TAVILY_API_KEY=

# ============================================
# OPTIONAL: TELEGRAM BOT
# ============================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID for notifications
TELEGRAM_CHAT_ID=

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=false

# ============================================
# OPTIONAL: DATABASE
# ============================================
# SQLite database for trade history
DATABASE_URL=sqlite:./data/trades.db

# ============================================
# OPTIONAL: REDIS (for signal queue)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log to file
LOG_FILE=./data/bot.log

# ============================================
# SAFETY SETTINGS
# ============================================
# Dry run mode - simulates trades without executing
DRY_RUN=false

# Maximum daily loss limit in USDC (stops trading if exceeded)
MAX_DAILY_LOSS=500

# Minimum time between trades on same market (seconds)
MIN_TRADE_INTERVAL=60
